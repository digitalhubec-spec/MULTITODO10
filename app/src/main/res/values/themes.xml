<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MULTITODO10" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set a solid background color for the splash screen -->
        <item name="windowSplashScreenBackground">@color/MultyPurple</item>
        
        <!-- (No icon is set here to prevent the crash) -->

        <!-- Set the theme to be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.MULTITODO10</item>
    </style>
</resources>